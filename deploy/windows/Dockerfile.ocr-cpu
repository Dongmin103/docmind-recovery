FROM docmind-surya-parser:pdf-ocr-choice-20261001-r1
COPY --chown=10001:10001 service.py /opt/surya/service.py
COPY --chown=10001:10001 models/ /models/
COPY --chown=10001:10001 llama-cpu/ /opt/llama/bin/
RUN chmod +x /opt/llama/bin/llama-*
ENV SURYA_EXECUTION_DEVICE=cpu LLAMA_CPP_NGL=0 \
    LLAMA_CPP_BINARY=/opt/llama/bin/llama-server CUDA_VISIBLE_DEVICES=-1
