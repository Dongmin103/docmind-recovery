# Documentation only. Copy values into an ignored file below .local/security.
# This preflight never makes docker-compose-windows-dev.yml production-ready.

DOCMIND_SECURITY_PREFLIGHT_MODE=certificate-prerequisite-only
DOCMIND_TLS_EXPECTED_DNS_NAME=docmind.internal.example
DOCMIND_TLS_MIN_VALID_DAYS=30

# Paths are resolved relative to app/docker. Keep private material below the
# ignored .local/security directory; never commit certificates from a private CA
# or a private key. The CA and leaf certificate must be different files.
DOCMIND_TLS_CA_CERT_FILE=../../.local/security/ca.pem
DOCMIND_TLS_SERVER_CERT_FILE=../../.local/security/server.pem
DOCMIND_TLS_SERVER_KEY_FILE=../../.local/security/server.key

# Host-only evidence consumed by Test-WindowsProductionSecurityReadiness.ps1.
# These files are not mounted into application services.
DOCMIND_TLS_ROTATION_EVIDENCE_FILE=../../.local/security/tls-rotation-evidence.json
DOCMIND_SECRET_PROVIDER_EVIDENCE_FILE=../../.local/security/secret-provider-evidence.json
DOCMIND_DOCKER_STORAGE_PATH=C:/replace/with/the/actual/Docker/or/WSL/data/location
