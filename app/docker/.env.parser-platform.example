# Kordoc search-parser deployment. The service remains on parser_internal only.
# Use a reviewed immutable image digest for KORDOC_IMAGE in production.
PARSER_PLATFORM_ENABLED=1
PARSER_PLATFORM_INTEGRATION_READY=1
PARSER_PLATFORM_PDF_ENABLED=1
PARSER_PLATFORM_OFFICE_ENABLED=1
PARSER_PLATFORM_HWP_ENABLED=1
PARSER_PLATFORM_KORDOC_PDF_ENABLED=1
PARSER_PLATFORM_KORDOC_DOCX_ENABLED=1
PARSER_PLATFORM_KORDOC_EXCEL_ENABLED=1
PARSER_PLATFORM_KORDOC_PPTX_ENABLED=1
# Native PPTX text/table/chart/SmartArt extraction is an explicit rollout.
PARSER_PLATFORM_PPTX_NATIVE_ENABLED=0
PARSER_PLATFORM_KORDOC_HWP_ENABLED=1
TE_RUN_MODE=0

KORDOC_IMAGE=docmind-kordoc-parser:4.15.7-cutover-amd64
KORDOC_OCR_MODEL_DIR=../models/kordoc
KORDOC_MEMORY_LIMIT=3g
KORDOC_CPUS=2

PARSER_PLATFORM_MAX_SOURCE_BYTES=536870912
PARSER_PLATFORM_KORDOC_MAX_SOURCE_BYTES=67108864
PARSER_PLATFORM_MAX_PDF_PAGES=2000
PARSER_PLATFORM_KORDOC_DEADLINE_SECONDS=900
PARSER_PLATFORM_PDF_DEADLINE_SECONDS=7200
PARSER_PLATFORM_PDF_HEARTBEAT_TIMEOUT_SECONDS=1800
