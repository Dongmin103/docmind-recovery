# Keep both gates off until migration, image digests and the target review pass.
# After the additive migration succeeds, set INTEGRATION_READY=1. If ingestion
# must be rolled back later, set only ENABLED=0 so active-set read isolation
# remains enforced for already versioned documents.
PARSER_PLATFORM_ENABLED=0
PARSER_PLATFORM_INTEGRATION_READY=0
TE_RUN_MODE=0
PARSER_PLATFORM_PLATFORM=linux/amd64

# The first target canary enables only parser-platform-cpu (Surya PDF).
# Office and HWP are separate opt-in profiles and are not part of the one-PDF proof.

# Replace tags with target-architecture immutable image digests before enabling.
SURYA_CPU_IMAGE=docmind-surya-parser:cpu-0.22.1-amd64
SURYA_MODEL_DIR=../models/surya
DOCLING_OFFICE_IMAGE=docmind-docling-office:2.115.0-amd64
DOCLING_UV_BASE_IMAGE=ghcr.io/astral-sh/uv:0.11.7@sha256:733b4042187702f832f7fdecb3aff14a61b288c4ca37af188bb5715c1caebaf8
DOCLING_PYTHON_BASE_IMAGE=python:3.12.13-slim-trixie@sha256:d657ab0ade19f404a6ccc883ab399540de667aff751748ce23c07330c5a89e64

# GPU mode remains fail-closed until an NVIDIA/vLLM runtime is built, pinned and reviewed.
SURYA_GPU_IMAGE=docmind-surya-parser:gpu-runtime-not-configured

SURYA_CPU_MEMORY_LIMIT=8g
SURYA_CPU_CPUS=8
DOCLING_OFFICE_MEMORY_LIMIT=2g
DOCLING_OFFICE_CPUS=2
SURYA_GPU_MEMORY_LIMIT=16g
SURYA_GPU_SHM_SIZE=4g

PARSER_PLATFORM_MAX_SOURCE_BYTES=536870912
PARSER_PLATFORM_MAX_MEDIA_BYTES=33554432
PARSER_PLATFORM_MAX_PDF_PAGES=2000
PARSER_PLATFORM_PDF_DEADLINE_SECONDS=7200
PARSER_PLATFORM_PDF_HEARTBEAT_TIMEOUT_SECONDS=1800
PARSER_PLATFORM_OFFICE_DEADLINE_SECONDS=900
