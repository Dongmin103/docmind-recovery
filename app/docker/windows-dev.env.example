# Documentation-only template. Do not copy placeholder credentials into a
# running stack. Generate an ignored local file with:
#   powershell -NoProfile -File ..\..\tools\windows\Initialize-WindowsDevelopmentDocker.ps1

STACK_VERSION=8.11.3
RAGFLOW_IMAGE=docmind-ragflow:windows-dev
DOC_ENGINE=elasticsearch
DEVICE=cpu
TZ=Asia/Seoul

# This Compose is intentionally limited to non-sensitive synthetic data. Its
# database/search/storage links are plaintext only inside the isolated bridge
# and on loopback host ports; it is not a production TLS/storage-encryption
# profile. The security initializer and runtime gate require these exact values.
DOCMIND_DEV_SECURITY_MODE=isolated-synthetic-only
DOCMIND_DEV_DATA_CLASS=synthetic-only
DOCMIND_DEV_ALLOW_PLAINTEXT_LOOPBACK=1
DOCMIND_DEV_EXTERNAL_API_POLICY=https-only

# Localhost-only host ports. Container ports remain unchanged.
DOCMIND_DEV_WEB_PORT=18080
DOCMIND_DEV_API_PORT=19380
DOCMIND_DEV_ADMIN_PORT=19381
DOCMIND_DEV_MYSQL_PORT=13306
DOCMIND_DEV_ES_PORT=19200
DOCMIND_DEV_REDIS_PORT=16379
DOCMIND_DEV_MINIO_PORT=19000
DOCMIND_DEV_MINIO_CONSOLE_PORT=19001
DOCMIND_DEV_BGE_PORT=16380

# The initializer replaces these placeholders with independent random local
# credentials. API credentials are deliberately blank until supplied locally.
MYSQL_PASSWORD=GENERATED_LOCALLY
MYSQL_DBNAME=rag_flow_dev
MYSQL_HOST=mysql
MYSQL_PORT=3306
ELASTIC_PASSWORD=GENERATED_LOCALLY
ES_HOST=es01
ES_PORT=9200
REDIS_PASSWORD=GENERATED_LOCALLY
REDIS_HOST=redis
REDIS_PORT=6379
MINIO_USER=GENERATED_LOCALLY
MINIO_PASSWORD=GENERATED_LOCALLY
MINIO_HOST=minio
MINIO_PORT=9000
STORAGE_IMPL=MINIO

TEI_HOST=bge-m3-cpu
BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
DOCMIND_RERANK_ID=jina-reranker-v3.5@jina@Jina
JINA_API_KEY=
DOCMIND_GENERATOR_MODEL=
DASHSCOPE_API_KEY=

PARSER_PLATFORM_ENABLED=0
PARSER_PLATFORM_INTEGRATION_READY=0
TE_RUN_MODE=0

ES_MEMORY_LIMIT=2g
MYSQL_MEMORY_LIMIT=1g
MINIO_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
RAGFLOW_MEMORY_LIMIT=4g
BGE_M3_MEMORY_LIMIT=4g
BGE_M3_MEMORY_SWAP_LIMIT=6g
BGE_M3_CPUS=4
