# Copy to docker/.env.docmind.cpu and replace every CHANGE_ME value.
# Never commit the resulting docker/.env.docmind.cpu file.

COMPOSE_PROJECT_NAME=docmind
COMPOSE_PROFILES=cpu,elasticsearch,metadata-mysql,parser-platform-cpu,bge-cpu
RAGFLOW_IMAGE=docmind-ragflow:0.27.1-cpu-amd64-production-routing-v3-hybrid-redacted

OPENVIKING_ROOT_API_KEY=CHANGE_ME_RANDOM_64_HEX
OPENVIKING_DATA_API_KEY=CHANGE_ME_OPENVIKING_USER_OR_ADMIN_KEY
JINA_API_KEY=CHANGE_ME
DASHSCOPE_API_KEY=
OPENVIKING_VLM_MODEL=qwen3.6-plus

DOCMIND_SHARED_USER_EMAIL=docmind@internal.invalid
DOCMIND_RERANK_ID=jina-reranker-v3@docmind-jina@Jina
DOCMIND_GENERATOR_MODEL=qwen3.8-flash-next@docmind-internal-qwen@OpenAI-API-Compatible

PARSER_PLATFORM_ENABLED=1
PARSER_PLATFORM_INTEGRATION_READY=1
PARSER_PLATFORM_PDF_ENABLED=1
PARSER_PLATFORM_OFFICE_ENABLED=0
PARSER_PLATFORM_HWP_ENABLED=0
PARSER_PLATFORM_HWP_INTEGRATION_READY=0
PARSER_PLATFORM_HWP_REGISTRATION_MODE=off
TE_RUN_MODE=0

SURYA_CPU_IMAGE=docmind-surya-parser:cpu-0.22.1-amd64-watchdog-v1
SURYA_MODEL_DIR=../models/surya
SURYA_CACHE_DIR=/var/lib/docmind/parser-artifacts/surya-cache
SURYA_CPU_MEMORY_LIMIT=8g
SURYA_CPU_CPUS=8
SURYA_SERVICE_PAGE_TIMEOUT_SECONDS=600
SURYA_SERVICE_REQUEST_TIMEOUT_SECONDS=1800
RAGFLOW_MEMORY_LIMIT=6g
OPENVIKING_MEMORY_LIMIT=3g
BGE_M3_IMAGE=ghcr.io/huggingface/text-embeddings-inference@sha256:ad950d30878eceb72aaf32024d26fa2b1d04a75304fa0b4776b49aa1941fea07
BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181
BGE_M3_MODEL_DIR=/home/uplexsoft/docmind-data/embedding-models/tei-bge-m3
OPENVIKING_DATA_DIR=/home/uplexsoft/docmind-data/openviking-bge
BGE_M3_PORT=6380
BGE_M3_MEMORY_LIMIT=6g
BGE_M3_MEMORY_SWAP_LIMIT=8g
BGE_M3_CPUS=8
OPENVIKING_CPUS=2
MEM_LIMIT=4g
MYSQL_MEMORY_LIMIT=2g
MINIO_MEMORY_LIMIT=2g
REDIS_MEMORY_LIMIT=512m

PARSER_PLATFORM_MAX_SOURCE_BYTES=536870912
PARSER_PLATFORM_MAX_PDF_PAGES=2000
PARSER_PLATFORM_PDF_DEADLINE_SECONDS=7200
PARSER_PLATFORM_PDF_HEARTBEAT_TIMEOUT_SECONDS=1800
PARSER_PLATFORM_PDF_ROUTING_ENABLED=0
PARSER_PLATFORM_PDF_ROUTING_CANARY_DOCUMENT_IDS=
PARSER_PLATFORM_PDF_ROUTING_MIN_TEXT_CHARS_PER_PAGE=120
PARSER_PLATFORM_PDF_ROUTING_MAX_IMAGE_AREA_PERCENT=60
PARSER_PLATFORM_PDF_ROUTING_MIN_TEXT_FIDELITY_PERCENT=97
PARSER_PLATFORM_PDF_ROUTING_SURYA_FALLBACK_MAX_PAGES=20
PARSER_PLATFORM_SURYA_REQUEST_BATCH_PAGES=1
PARSER_PLATFORM_DOCLING_PDF_DEADLINE_SECONDS=900
DOCLING_PDF_MEMORY_LIMIT=2g
DOCLING_PDF_CPUS=4

DOCMIND_PRIVATE_DIR=../runtime/private
DOCMIND_CANARY_MODE=1
