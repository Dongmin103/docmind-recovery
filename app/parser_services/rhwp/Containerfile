ARG UV_BASE_IMAGE=ghcr.io/astral-sh/uv:0.11.7@sha256:733b4042187702f832f7fdecb3aff14a61b288c4ca37af188bb5715c1caebaf8
ARG PYTHON_BASE_IMAGE=python:3.12.13-slim-trixie@sha256:d657ab0ade19f404a6ccc883ab399540de667aff751748ce23c07330c5a89e64
FROM ${UV_BASE_IMAGE} AS uv
FROM ${PYTHON_BASE_IMAGE}

USER root
WORKDIR /opt/rhwp

COPY --from=uv /uv /uvx /bin/
COPY parser_services/rhwp/pyproject.toml parser_services/rhwp/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    apt-get update && \
    apt-get install --no-install-recommends --yes libexpat1 libfreetype6 && \
    rm -rf /var/lib/apt/lists/* && \
    uv sync --frozen --no-dev --no-install-project && \
    groupadd --gid 10001 parser && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin parser

COPY parser_services/rhwp/service.py parser_services/rhwp/hybrid_chunker.py /opt/rhwp/
COPY parser_services/rhwp/tokenizer/ /opt/rhwp/tokenizer/

ENV PATH="/opt/rhwp/.venv/bin:${PATH}" \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libfreetype.so.6 \
    RHWP_SERVICE_HOST=0.0.0.0 \
    RHWP_SERVICE_PORT=8093 \
    RHWP_MAX_SOURCE_BYTES=536870912 \
    RHWP_CHUNK_MAX_TOKENS=512 \
    RHWP_CHUNK_TOKENIZER_PATH=/opt/rhwp/tokenizer \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DO_NOT_TRACK=1

EXPOSE 8093
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=12 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8093/health', timeout=3).read()"]

USER 10001:10001
ENTRYPOINT ["python", "/opt/rhwp/service.py"]

LABEL io.docmind.service="rhwp-parser" \
      io.docmind.rhwp-python-version="0.8.1" \
      io.docmind.rhwp-core-revision="10f5c51e65e0e8e9260cf1498972db14ea04c29e" \
      io.docmind.hwp-chunker="docling-hybrid-2.92.0+docmind-compact-rowspan-v1" \
      io.docmind.hwp-chunk-tokens="512" \
      io.docmind.media-ocr-enabled="false" \
      io.docmind.concurrency="1"
