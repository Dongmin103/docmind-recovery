FROM node:24.19.0-bookworm-slim@sha256:e5a8dee7bc1e6a215d224a7ef8206f7e77271bc3cabd5febf2beafac0674f174

WORKDIR /opt/kordoc
ARG LIBREOFFICE_PACKAGE_VERSION=4:7.4.7-1+deb12u14
RUN apt-get update && apt-get install --no-install-recommends -y \
    "libreoffice-core=${LIBREOFFICE_PACKAGE_VERSION}" \
    "libreoffice-writer=${LIBREOFFICE_PACKAGE_VERSION}" \
    "libreoffice-impress=${LIBREOFFICE_PACKAGE_VERSION}" && \
    rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@11.19.0
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/
RUN echo '25378aebb75d6507296cc22b60a6158935ca3af5a4ac888708b3cee08f21646b  patches/kordoc@4.15.7.patch' | sha256sum -c - && \
    pnpm install --frozen-lockfile --ignore-scripts --prod && \
    groupadd --gid 10001 parser && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin parser
COPY src/ ./src/

ENV KORDOC_OFFLINE=1 \
    KORDOC_HOST=0.0.0.0 \
    KORDOC_PORT=8095 \
    KORDOC_MAX_SOURCE_BYTES=67108864 \
    KORDOC_TIMEOUT_MS=900000 \
    NODE_ENV=production

USER 10001:10001
EXPOSE 8095
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=12 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8095/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["node", "/opt/kordoc/src/server.mjs"]
