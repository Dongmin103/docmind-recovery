FROM nvidia/cuda:12.4.1-devel-ubuntu22.04@sha256:5645fec64549cc35930eee9d85aafd2b0006c0c3f22632be5a1d85e2604e9749 AS llama-builder

ARG LLAMA_CPP_RELEASE=b10718
ARG LLAMA_CPP_COMMIT=41ef91f7c8046087cdfbb276b79bff311ecf1c6d

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake git ninja-build && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${LLAMA_CPP_RELEASE}" \
      https://github.com/ggml-org/llama.cpp.git /opt/llama-src && \
    test "$(git -C /opt/llama-src rev-parse HEAD)" = "${LLAMA_CPP_COMMIT}" && \
    cmake -S /opt/llama-src -B /opt/llama-src/build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CUDA_ARCHITECTURES=61 \
      -DGGML_CUDA=ON \
      -DGGML_CUDA_NO_VMM=ON \
      -DGGML_NATIVE=OFF \
      -DLLAMA_CURL=OFF \
      -DLLAMA_BUILD_TESTS=OFF && \
    cmake --build /opt/llama-src/build --target llama-server --parallel 4 && \
    test -x /opt/llama-src/build/bin/llama-server

FROM ghcr.io/astral-sh/uv:0.11.7@sha256:733b4042187702f832f7fdecb3aff14a61b288c4ca37af188bb5715c1caebaf8 AS uv
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04@sha256:cff3a0d82d2c2b47bab252d67fa9b34a20ef4c50781d98501b5c7367ea9afd10

USER root
WORKDIR /opt/surya

COPY --from=uv /uv /uvx /bin/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates libgl1 libglib2.0-0 libgomp1 libstdc++6 && \
    rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_INSTALL_DIR="/opt/uv-python" \
    UV_PYTHON_PREFERENCE="only-managed" \
    UV_LINK_MODE="copy"

COPY parser_services/surya/pyproject.toml parser_services/surya/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv python install 3.12.13 && \
    uv sync --python 3.12.13 --frozen --no-dev --no-install-project && \
    chmod -R a+rX /opt/uv-python

COPY --from=llama-builder /opt/llama-src/build/bin /opt/llama
COPY parser_services/surya/service.py /opt/surya/service.py

RUN test -x /opt/llama/llama-server && \
    groupadd --gid 10001 parser && \
    useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin parser && \
    mkdir -p /opt/surya/runtime /home/parser/.cache/datalab/surya && \
    chown -R 10001:10001 /opt/surya/runtime /home/parser

ENV PATH="/opt/surya/.venv/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/llama:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}" \
    HF_HUB_OFFLINE="1" \
    HF_HUB_DISABLE_TELEMETRY="1" \
    TRANSFORMERS_OFFLINE="1" \
    DO_NOT_TRACK="1" \
    SURYA_SERVICE_HOST="0.0.0.0" \
    SURYA_SERVICE_PORT="8091" \
    SURYA_INFERENCE_BACKEND="llamacpp" \
    SURYA_INFERENCE_AUTOSTART="1" \
    SURYA_INFERENCE_PARALLEL="1" \
    SURYA_INFERENCE_CTX_SIZE="16384" \
    SURYA_INFERENCE_CTX_PER_SLOT="16384" \
    SURYA_INFERENCE_TIMEOUT_SECONDS="7200" \
    SURYA_INFERENCE_STARTUP_TIMEOUT="900" \
    SURYA_INFERENCE_LOGPROBS="0" \
    SURYA_GGUF_LOCAL_MODEL_PATH="/models/surya-2.gguf" \
    SURYA_GGUF_LOCAL_MMPROJ_PATH="/models/surya-2-mmproj.gguf" \
    SURYA_GGUF_MODEL_SHA256="1f18abe17b1ed8b4e47ee9b1ad0e274c93daf5efbb6b29a04ff1712e37051e05" \
    SURYA_GGUF_MMPROJ_SHA256="98c0563673b1657ff6d021d1e5f04af06cbf61bb40c63ac613e8bb71b42fb2c0" \
    LLAMA_CPP_BINARY="/opt/llama/llama-server" \
    LLAMA_CPP_NGL="99" \
    LLAMA_CPP_EXTRA_ARGS="--threads 8"

EXPOSE 8091

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=20 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=3).read()"]

USER 10001:10001
ENTRYPOINT ["python", "/opt/surya/service.py"]

LABEL org.opencontainers.image.title="DocMind Surya CUDA parser" \
      org.opencontainers.image.version="surya-ocr-0.22.1" \
      org.opencontainers.image.source="https://github.com/Dongmin103/docmind-ragflow" \
      io.docmind.platform="linux/amd64" \
      io.docmind.surya-model-distribution="external-volume" \
      io.docmind.llama-cpp.release="b10718" \
      io.docmind.cuda="12.4.1" \
      io.docmind.cuda.arch="sm61" \
      io.docmind.concurrency="1"
