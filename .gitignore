# Private recovery inputs and authentication material must stay outside Git.
*.key
*.pem
*.p12
*.pfx
.env
.env.*
*private*
*.tar
*.tar.gz
*.bundle
*.enc
*.unverified
__pycache__/
restore-test/

# Encrypted archives are distributed as release assets, not Git blobs.

# Development handoff: no local secrets or data
.local/
**/.env
**/.env.local
**/.env.docmind.cpu
**/.env.*.local
app/conf/private.pem
app/conf/public.pem
app/conf/service_conf.yaml
**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
**/runtime/
**/uploads/
**/logs/
